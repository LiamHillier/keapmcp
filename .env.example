# Keap Personal Access Token or Service Account Key
# Settings -> API Settings in your Keap app, or https://developer.infusionsoft.com/pat-and-sak/
KEAP_PAT=your_token_here

# Optional: apikey (default, sends X-Keap-API-Key) | bearer (sends Authorization: Bearer)
# KEAP_AUTH_MODE=apikey

# Optional tuning
# KEAP_MAX_QPS=8
# KEAP_TIMEOUT_MS=30000
# KEAP_CACHE_TTL_MS=60000

# --- Hosted mode only (`npm run start:http`, see README "Hosting it remotely") ---
# Shared secret remote clients send as `Authorization: Bearer <token>`. Required.
# Generate one with: openssl rand -hex 32
# KEAP_MCP_AUTH_TOKEN=
# KEAP_MCP_HOST=127.0.0.1   # use 0.0.0.0 inside a container
# KEAP_MCP_PORT=3000
# KEAP_MCP_PATH=/mcp
